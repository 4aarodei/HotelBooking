@model HotelBooking.Web.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Головна";
}

<section class="hero-section">
    <div class="container">
        <div class="hero-card text-center">
            <div class="row align-items-center g-4">
                <div class="col-lg-7 text-lg-start">
                    <p class="eyebrow text-uppercase mb-2">Нове враження від подорожей</p>
                    <h1 class="hero-title fw-bold mb-3">Бронюйте готелі в один дотик</h1>
                    <p class="hero-subtitle mb-0">Сучасний простір для пошуку, вибору та бронювання улюблених готелів по всій Україні.</p>
                </div>
                <div class="col-lg-5">
                    <form class="search-panel p-4" method="get" asp-controller="Hotel" asp-action="Index">
                        <div class="row g-3 align-items-end">
                            <div class="col-sm-6">
                                <label class="form-label text-muted" for="search-city">Місто</label>
                                <input type="text" id="search-city" name="city" class="form-control" placeholder="Вкажіть місто" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label text-muted" for="search-check-in">Дата заїзду</label>
                                <input type="date" id="search-check-in" name="checkIn" class="form-control" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label text-muted" for="search-check-out">Дата виїзду</label>
                                <input type="date" id="search-check-out" name="checkOut" class="form-control" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label text-muted" for="search-guests">Гості</label>
                                <select id="search-guests" name="guests" class="form-select">
                                    @for (int i = 1; i <= 6; i++)
                                    {
                                        <option value="@i">@i гість</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 d-grid">
                                <button type="submit" class="btn btn-primary" formnovalidate>Знайти пропозиції</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="section-heading">
            <div>
                <p class="eyebrow mb-1">Добірка готелів</p>
                <h2 class="h4 mb-0">Популярні готелі</h2>
            </div>
            <span class="tag-pill">@Model?.PopularHotels?.Count() </span>
        </div>

        @if (Model?.PopularHotels != null && Model.PopularHotels.Any())
        {
            <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-xl-3">
                @foreach (var hotel in Model.PopularHotels)
                {
                    <div class="col">
                        <partial name="_HotelCard" model="hotel" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                Наразі немає популярних готелів.
            </div>
        }
    </div>
</section>
