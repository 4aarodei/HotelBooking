@using HotelBooking.ViewModels
@model CreateBookingRequest

@{
    ViewData["Title"] = "Бронювання номера";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <p class="eyebrow mb-2">Крок бронювання</p>
            <h1 class="display-6 fw-bold mb-2">Бронювання номера</h1>
            <p class="text-muted mb-4">Оберіть дати заїзду та виїзду</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger d-flex align-items-start" role="alert">
                    <div class="me-3 fw-bold">!</div>
                    <div>
                        <h4 class="alert-heading h6 mb-2">Номер недоступний</h4>
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" method="post" class="row g-3 profile-form">
                        <input type="hidden" asp-for="RoomId" />

                        <div class="col-md-6">
                            <label asp-for="CheckIn" class="form-label">Дата заїзду</label>
                            <input asp-for="CheckIn" type="date" class="form-control" />
                            <span asp-validation-for="CheckIn" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CheckOut" class="form-label">Дата виїзду</label>
                            <input asp-for="CheckOut" type="date" class="form-control" />
                            <span asp-validation-for="CheckOut" class="text-danger small"></span>
                        </div>

                        <div class="col-12 d-grid d-sm-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-primary">Забронювати</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
