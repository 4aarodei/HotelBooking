@{
    Layout = "~/Views/UserProfile/_Shared/_ProfileLayout.cshtml";
    ViewData["Title"] = "Безпека";
}

<section class="card shadow-sm">
    <div class="card-body">
        <div class="section-heading mb-3">
            <div>
                <p class="eyebrow mb-1">Безпека</p>
                <h1 class="h4 mb-0">Безпека</h1>
            </div>
        </div>
        <form class="profile-form row g-3">
            <div class="col-12">
                <label class="form-label">Поточний пароль</label>
                <input type="password" class="form-control" />
            </div>

            <div class="col-12">
                <label class="form-label">Новий пароль</label>
                <input type="password" class="form-control" />
            </div>

            <div class="col-12">
                <label class="form-label">Підтвердіть новий пароль</label>
                <input type="password" class="form-control" />
            </div>

            <div class="col-12 d-grid d-sm-flex justify-content-end gap-2">
                <button class="btn btn-primary" type="submit">Оновити пароль</button>
            </div>
        </form>
    </div>
</section>
