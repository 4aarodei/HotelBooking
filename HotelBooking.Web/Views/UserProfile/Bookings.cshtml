@model IReadOnlyList<HotelBooking.Web.ViewModels.UserProfileViewModels.UserBookingItemViewModel>

@{
    Layout = "~/Views/UserProfile/_Shared/_ProfileLayout.cshtml";
    ViewData["Title"] = "My bookings";
}

<section class="card shadow-sm">
    <div class="card-body">
        <div class="section-heading mb-3">
            <div>
                <p class="eyebrow mb-1">Bookings</p>
                <h1 class="h4 mb-0">My bookings</h1>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">You do not have bookings yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Hotel</th>
                            <th>Room</th>
                            <th>Dates</th>
                            <th>Nights</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.HotelName</td>
                                <td>@item.RoomName</td>
                                <td>@item.CheckIn.ToString("dd.MM.yyyy") — @item.CheckOut.ToString("dd.MM.yyyy")</td>
                                <td>@item.Nights</td>
                                <td>@item.TotalPrice.ToString("0.##") ₴</td>
                                <td><span class="badge text-bg-secondary">@item.StatusName</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
