@model List<HotelBooking.Web.ViewModels.UserProfileViewModels.UserBookingItemViewModel>

@{
    Layout = "~/Views/UserProfile/_Shared/_ProfileLayout.cshtml";
    ViewData["Title"] = "My bookings";
}

<section class="card shadow-sm">
    <div class="card-body">
        <div class="section-heading mb-3">
            <div>
                <p class="eyebrow mb-1">Історія</p>
                <h1 class="h4 mb-0">My bookings</h1>
            </div>
        </div>
        <div class="list-group list-group-flush">
            @if (Model.Count == 0)
            {
                <div class="list-group-item text-muted">Бронювань ще немає.</div>
            }
            else
            {
                @foreach (var booking in Model)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <strong class="d-block">@booking.HotelName — @booking.RoomName</strong>
                            <small class="text-muted">
                                @booking.CheckIn:dd.MM.yyyy – @booking.CheckOut:dd.MM.yyyy
                                · @booking.Nights ночей
                            </small>
                            <div class="text-muted small">@booking.StatusName</div>
                        </div>
                        <span class="badge text-bg-primary">@booking.TotalPrice ₴</span>
                    </div>
                }
            }
        </div>
    </div>
</section>
