@model HotelBooking.Web.ViewModels.HotelIndexViewModel

<section class="hero-section text-center py-5">
    <div class="container">
        <p class="eyebrow mb-2">Результати пошуку</p>
        <h1 class="display-6 fw-bold mb-2">Готелі в місті @Model.City</h1>
        <p class="text-muted mb-1">Знайдено @Model.Hotels.Count готелів</p>
        <p class="text-muted">Доступні на дати @Model.CheckIn:dd.MM.yyyy — @Model.CheckOut:dd.MM.yyyy</p>
    </div>
</section>

<section class="pb-5">
    <div class="container">
        <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-xl-3">
            @foreach (var hotel in Model.Hotels)
            {
                <div class="col">
                    <partial name="_HotelCard" model="hotel" />
                </div>
            }
        </div>
    </div>
</section>
