{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "SET_VIA_USER_SECRETS_OR_ENV"
  },
  "ImageStorage": {
    "Provider": "Local",
    "RootDirectory": "uploads",
    "MaxFileSizeBytes": 5242880,
    "MaxFilesPerUpload": 8,
    "MaxWidth": 4096,
    "MaxHeight": 4096,
    "MaxPixelCount": 12000000,
    "ReencodeQuality": 82,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ],
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp"
    ],
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "hotel-images",
      "PublicBaseUrl": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
