{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "SET_VIA_USER_SECRETS_OR_ENV"
  },
  "Azure": {
    "KeyVault": {
      "Uri": ""
    }
  },
  "Sql": {
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "",
    "InstanceName": "HotelBooking:",
    "RequiredForReadiness": false,
    "RateLimiting": {
      "Enabled": false
    }
  },
  "DataProtection": {
    "ApplicationName": "HotelBooking",
    "PersistKeysToFileSystemPath": ""
  },
  "ImageStorage": {
    "Provider": "",
    "MaxFileSizeBytes": 5242880,
    "MaxFilesPerUpload": 8,
    "MaxWidth": 4096,
    "MaxHeight": 4096,
    "MaxPixelCount": 12000000,
    "ReencodeQuality": 82,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ],
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp"
    ],
    "RootDirectory": "uploads",
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "",
      "PublicBaseUrl": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
