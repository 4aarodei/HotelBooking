@model IEnumerable<HotelBooking.ViewModels.Admin.AdminHotelListItemViewModel>
@{
    ViewData["Title"] = "Hotel management";
}

<section class="py-5 mt-4">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <p class="text-uppercase text-muted small mb-1">Administration</p>
                <h1 class="h3 fw-bold mb-0">Hotels</h1>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Dashboard
                </a>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> Add hotel
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-surface table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Photo</th>
                            <th>Name</th>
                            <th>City</th>
                            <th>Address</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hotel in Model)
                        {
                            <tr>
                                <td style="width: 88px;">
                                    @if (!string.IsNullOrWhiteSpace(hotel.CoverImageUrl))
                                    {
                                        <img src="@hotel.CoverImageUrl" class="admin-table-thumb" alt="@hotel.Name" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="admin-table-thumb admin-image-empty">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </td>
                                <td class="fw-semibold">@hotel.Name</td>
                                <td>@hotel.City</td>
                                <td class="text-muted">@hotel.Address</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@hotel.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-building fs-1 d-block mb-3"></i>
                    <p class="mb-0">No hotels yet. Add the first one to start.</p>
                </div>
            }
        </div>
    </div>
</section>
