@model HotelBooking.ViewModels.Admin.AdminHotelFormViewModel
@{
    ViewData["Title"] = "Редагувати готель";
}

<section class="py-5 mt-4">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <p class="text-uppercase text-muted small mb-1">Редагування</p>
                <h1 class="h3 fw-bold mb-0">@Model.Name</h1>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Назад до списку
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <partial name="_HotelForm" />

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-link text-decoration-none">Скасувати</a>
                        <button type="submit" class="btn btn-primary">Оновити</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 mb-3 gap-3">
            <div>
                <p class="text-uppercase text-muted small mb-1">Inventory</p>
                <h2 class="h4 fw-bold mb-0">Rooms</h2>
            </div>
            <a asp-action="CreateRoom" asp-route-hotelId="@Model.Id" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Add room
            </a>
        </div>

        @if (Model.Rooms.Any())
        {
            <div class="row g-3 row-cols-1 row-cols-lg-2">
                @foreach (var room in Model.Rooms)
                {
                    <div class="col">
                        <div class="card h-100 admin-room-card">
                            @if (!string.IsNullOrWhiteSpace(room.CoverImageUrl))
                            {
                                <img src="@room.CoverImageUrl" class="admin-room-thumb" alt="@room.Name" width="@(room.CoverImageWidth > 0 ? room.CoverImageWidth : null)" height="@(room.CoverImageHeight > 0 ? room.CoverImageHeight : null)" loading="lazy" />
                            }
                            else
                            {
                                <div class="admin-room-thumb admin-image-empty">
                                    <i class="bi bi-image"></i>
                                </div>
                            }
                            <div class="card-body d-flex flex-column gap-2">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <h3 class="h5 mb-0">@room.Name</h3>
                                    <span class="badge @(room.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                        @(room.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                                <div class="text-muted small">@room.Capacity guests · @room.Quantity units</div>
                                <div class="fw-semibold">@room.PricePerNight.ToString("0.00") ₴ / night</div>
                                <a asp-action="EditRoom" asp-route-id="@room.Id" class="btn btn-outline-primary mt-auto">
                                    <i class="bi bi-pencil"></i> Edit room
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                No rooms yet. Add the first room to make this hotel bookable.
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
