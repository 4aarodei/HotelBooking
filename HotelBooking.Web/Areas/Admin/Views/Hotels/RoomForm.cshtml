@model HotelBooking.ViewModels.Admin.AdminRoomFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit room" : "Add room";
}

<section class="py-5 mt-4">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <p class="text-uppercase text-muted small mb-1">@Model.HotelName</p>
                <h1 class="h3 fw-bold mb-0">@(isEdit ? "Edit room" : "Add room")</h1>
            </div>
            <a asp-action="Edit" asp-route-id="@Model.HotelId" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to hotel
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="@(isEdit ? "EditRoom" : "CreateRoom")" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="HotelId" />
                    <input type="hidden" asp-for="HotelName" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Deluxe Panorama" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Capacity" class="form-label">Capacity</label>
                            <input asp-for="Capacity" type="number" min="1" class="form-control" />
                            <span asp-validation-for="Capacity" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Quantity" class="form-label">Quantity</label>
                            <input asp-for="Quantity" type="number" min="1" class="form-control" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PricePerNight" class="form-label">Price per night</label>
                            <input asp-for="PricePerNight" type="number" min="0.01" step="0.01" class="form-control" />
                            <span asp-validation-for="PricePerNight" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label">Available for booking</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Photos" class="form-label">Room photos</label>
                            <input asp-for="Photos" type="file" accept="image/jpeg,image/png,image/webp" multiple class="form-control" />
                            <div class="form-text">JPG, PNG, or WebP. Up to 5 MB per image.</div>
                            <span asp-validation-for="Photos" class="text-danger"></span>
                        </div>

                        @if (Model.ExistingImages.Any())
                        {
                            <div class="col-12">
                                <div class="admin-gallery-grid">
                                    @foreach (var image in Model.ExistingImages)
                                    {
                                        <label class="admin-image-tile">
                                            <img src="@image.Url" alt="@image.AltText" loading="lazy" />
                                            <span class="admin-image-meta">
                                                @if (image.IsCover)
                                                {
                                                    <span class="badge text-bg-primary">Cover</span>
                                                }
                                                <span class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="RemoveImageIds" value="@image.Id" />
                                                    <span class="form-check-label">Remove</span>
                                                </span>
                                            </span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model.HotelId" class="btn btn-link text-decoration-none">Cancel</a>
                        <button type="submit" class="btn btn-primary">@(isEdit ? "Update" : "Create")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
