@model HotelBooking.ViewModels.Admin.AdminRoomFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit room" : "Add room";
}

<section class="py-5 mt-4">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <p class="text-uppercase text-muted small mb-1">@Model.HotelName</p>
                <h1 class="h3 fw-bold mb-0">@(isEdit ? "Edit room" : "Add room")</h1>
            </div>
            <a asp-controller="Hotels" asp-action="Edit" asp-route-id="@Model.HotelId" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to hotel
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-controller="Rooms" asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="HotelId" />
                    <input type="hidden" asp-for="HotelName" />
                    <input type="hidden" asp-for="DraftUploadId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Deluxe Panorama" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Capacity" class="form-label">Capacity</label>
                            <input asp-for="Capacity" type="number" min="1" class="form-control" />
                            <span asp-validation-for="Capacity" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Quantity" class="form-label">Quantity</label>
                            <input asp-for="Quantity" type="number" min="1" class="form-control" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PricePerNight" class="form-label">Price per night</label>
                            <input asp-for="PricePerNight" type="number" min="0.01" step="0.01" class="form-control" />
                            <span asp-validation-for="PricePerNight" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label">Available for booking</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" rows="4" class="form-control" placeholder="Quiet room with river view, soft lighting, and a comfortable seating area."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Amenities" class="form-label">Additional amenities</label>
                            <textarea asp-for="Amenities" rows="3" class="form-control" placeholder="King bed, coffee machine, blackout curtains, premium toiletries"></textarea>
                            <div class="form-text">Use commas or new lines for room-specific advantages.</div>
                            <span asp-validation-for="Amenities" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="row g-2">
                                <div class="col-sm-6 col-lg-4">
                                    <div class="form-check">
                                        <input asp-for="IncludesBreakfast" class="form-check-input" />
                                        <label asp-for="IncludesBreakfast" class="form-check-label">Breakfast included</label>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-4">
                                    <div class="form-check">
                                        <input asp-for="HasPrivateBathroom" class="form-check-input" />
                                        <label asp-for="HasPrivateBathroom" class="form-check-label">Private bathroom</label>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-4">
                                    <div class="form-check">
                                        <input asp-for="HasSaunaAccess" class="form-check-input" />
                                        <label asp-for="HasSaunaAccess" class="form-check-label">Sauna access</label>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-4">
                                    <div class="form-check">
                                        <input asp-for="HasBalcony" class="form-check-input" />
                                        <label asp-for="HasBalcony" class="form-check-label">Balcony</label>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-4">
                                    <div class="form-check">
                                        <input asp-for="HasWorkspace" class="form-check-input" />
                                        <label asp-for="HasWorkspace" class="form-check-label">Workspace</label>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-4">
                                    <div class="form-check">
                                        <input asp-for="HasAirConditioning" class="form-check-input" />
                                        <label asp-for="HasAirConditioning" class="form-check-label">Air conditioning</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Photos" class="form-label">Room photos</label>
                            <input asp-for="Photos" id="room-photos-input" type="file" accept="image/jpeg,image/png,image/webp" multiple class="form-control" />
                            <div class="form-text">JPG, PNG, or WebP. Up to 5 MB per image.</div>
                            @if (!isEdit)
                            {
                                <div id="room-upload-status" class="form-text mt-1"></div>
                            }
                            <span asp-validation-for="Photos" class="text-danger"></span>
                        </div>

                        @if (Model.ExistingImages.Any())
                        {
                            <div class="col-12">
                                <div class="admin-gallery-grid">
                                    @foreach (var image in Model.ExistingImages)
                                    {
                                        <label class="admin-image-tile">
                                            <img src="@image.Url" alt="@image.AltText" width="@(image.Width > 0 ? image.Width : null)" height="@(image.Height > 0 ? image.Height : null)" loading="lazy" />
                                            <span class="admin-image-meta">
                                                @if (image.IsCover)
                                                {
                                                    <span class="badge text-bg-primary">Cover</span>
                                                }
                                                <label class="form-check admin-remove-check">
                                                    <input class="form-check-input" type="checkbox" name="RemoveImageIds" value="@image.Id" />
                                                    <span class="form-check-label">Remove</span>
                                                </label>
                                            </span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="Hotels" asp-action="Edit" asp-route-id="@Model.HotelId" id="room-form-cancel" class="btn btn-link text-decoration-none">Cancel</a>
                        <button type="submit" class="btn btn-primary">@(isEdit ? "Update" : "Create")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (!isEdit)
    {
        <script>
            (() => {
                const form = document.querySelector('form[enctype="multipart/form-data"]');
                const fileInput = document.getElementById('room-photos-input');
                const status = document.getElementById('room-upload-status');
                const cancelLink = document.getElementById('room-form-cancel');
                if (!form || !fileInput || !status || !cancelLink) return;

                const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                const draftInput = form.querySelector('input[name="DraftUploadId"]');
                const hotelIdInput = form.querySelector('input[name="HotelId"]');
                if (!tokenInput || !draftInput || !hotelIdInput) return;

                const uploadUrl = '@Url.Action("Upload", "RoomDraftPhotos", new { area = "Admin" })';
                const discardUrl = '@Url.Action("Discard", "RoomDraftPhotos", new { area = "Admin" })';

                fileInput.addEventListener('change', async () => {
                    const files = fileInput.files;
                    if (!files || files.length === 0) return;

                    status.textContent = `Uploading ${files.length} file(s)...`;

                    const data = new FormData();
                    data.append('__RequestVerificationToken', tokenInput.value);
                    data.append('hotelId', hotelIdInput.value);
                    data.append('draftUploadId', draftInput.value);
                    for (const file of files) {
                        data.append('photos', file);
                    }

                    try {
                        const response = await fetch(uploadUrl, {
                            method: 'POST',
                            body: data
                        });

                        if (!response.ok) {
                            const err = await response.json().catch(() => null);
                            status.textContent = err?.message ?? 'Upload failed.';
                            return;
                        }

                        const payload = await response.json();
                        status.textContent = `Uploaded ${payload.count ?? files.length} file(s).`;
                        fileInput.value = '';
                    } catch {
                        status.textContent = 'Upload failed.';
                    }
                });

                cancelLink.addEventListener('click', async (event) => {
                    event.preventDefault();

                    const data = new FormData();
                    data.append('__RequestVerificationToken', tokenInput.value);
                    data.append('draftUploadId', draftInput.value);

                    try {
                        await fetch(discardUrl, {
                            method: 'POST',
                            body: data
                        });
                    } catch {
                    }

                    window.location.href = cancelLink.href;
                });
            })();
        </script>
    }
}
