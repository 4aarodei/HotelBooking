@page
@model LoginModel

@{
    ViewData["Title"] = "Вхід";
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-shell">
    <div class="auth-card">
        <p class="eyebrow mb-2 text-uppercase">Ласкаво просимо</p>
        <h1 class="auth-title">Вхід</h1>
        <p class="auth-subtitle">Увійдіть у свій акаунт</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="auth-error"></div>

            <div class="form-group">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" autocomplete="username" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" autocomplete="current-password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="form-remember d-flex align-items-center gap-2 mb-3">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-2">
                Увійти
            </button>
        </form>

        <div class="auth-links">
            <a asp-page="./ForgotPassword">Забули пароль?</a>
            <a asp-page="./Register">Створити акаунт</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
