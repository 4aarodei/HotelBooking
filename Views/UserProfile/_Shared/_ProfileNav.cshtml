@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="card shadow-sm">
    <div class="card-body d-flex align-items-center gap-3 pb-3 border-bottom border-secondary-subtle">
        <span class="avatar-circle lg">@(User.Identity?.Name?.Substring(0, 1) ?? "?")</span>
        <div>
            <strong class="d-block">@User.Identity?.Name</strong>
            <small class="text-muted">Your personal account</small>
        </div>
    </div>
    <div class="list-group list-group-flush">
        <a class="list-group-item list-group-item-action @(action == "Index" ? "active" : "")" asp-action="Index">Public profile</a>
        <a class="list-group-item list-group-item-action @(action == "Bookings" ? "active" : "")" asp-action="Bookings">My bookings</a>
        <a class="list-group-item list-group-item-action @(action == "Security" ? "active" : "")" asp-action="Security">Security</a>
    </div>
</div>
