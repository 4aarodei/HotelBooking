@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<nav class="profile-nav">

    <div class="profile-nav-header">
        <span class="auth-avatar big">
            @(User.Identity?.Name?.Substring(0, 1) ?? "?")
        </span>

        <div class="profile-nav-user">
            <strong>@User.Identity?.Name</strong>
            <span>Your personal account</span>
        </div>
    </div>

    <ul class="profile-nav-list">

        <li class="@(action == "Index" ? "active" : "")">
            <a asp-action="Index">Public profile</a>
        </li>

        <li class="@(action == "Bookings" ? "active" : "")">
            <a asp-action="Bookings">My bookings</a>
        </li>

        <li class="@(action == "Security" ? "active" : "")">
            <a asp-action="Security">Security</a>
        </li>

    </ul>
</nav>
