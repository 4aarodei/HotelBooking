@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="card shadow-sm profile-nav">
    <div class="card-body d-flex align-items-center gap-3 pb-3 border-bottom border-secondary-subtle">
        <span class="avatar-circle lg">@(User.Identity?.Name?.Substring(0, 1) ?? "?")</span>
        <div>
            <strong class="d-block">@User.Identity?.Name</strong>
            <small class="text-muted">Ваш персональний кабінет</small>
        </div>
    </div>
    <div class="list-group list-group-flush">
        <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 @(action == "Index" ? "active" : "")" asp-action="Index">
            <i class="bi bi-person"></i>
            <span>Public profile</span>
        </a>
        <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 @(action == "Bookings" ? "active" : "")" asp-action="Bookings">
            <i class="bi bi-calendar2-check"></i>
            <span>My bookings</span>
        </a>
        <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 @(action == "Security" ? "active" : "")" asp-action="Security">
            <i class="bi bi-shield-lock"></i>
            <span>Security</span>
        </a>
        <form asp-controller="UserProfile"
              asp-action="Logout"
              method="post"
              class="list-group-item list-group-item-action p-0">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-link text-start w-100 text-decoration-none logout-btn d-flex align-items-center gap-2">
                <i class="bi bi-box-arrow-right"></i>
                <span>Log Out</span>
            </button>
        </form>

    </div>
</div>
