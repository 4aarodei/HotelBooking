@model HotelBooking.ViewModels.UserProfileViewModels.UserProfileIndexModel

@{
    Layout = "~/Views/UserProfile/_Shared/_ProfileLayout.cshtml";
    ViewData["Title"] = "Public profile";
}

<section class="profile-card">

    <h1>Public profile</h1>

    <form asp-action="UpdatePublicProfile" method="post" class="profile-form">
        @Html.AntiForgeryToken()

        <div class="profile-field">
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" />
            <span asp-validation-for="FirstName"></span>
        </div>

        <div class="profile-field">
            <label asp-for="LastName"></label>
            <input asp-for="LastName" />
            <span asp-validation-for="LastName"></span>
        </div>

        <div class="profile-field">
            <label>Email</label>
            <input type="email" value="@User.Identity?.Name" disabled />
        </div>

        <button type="submit" class="btn-primary">
            Save changes
        </button>
    </form>

</section>
