@model string
@{
    var tab = Model ?? "public";
}

<nav class="profile-nav">

    <div class="profile-nav-header">
        <span class="auth-avatar big">
            @(User.Identity?.Name?.Substring(0, 1) ?? "?")
        </span>

        <div class="profile-nav-user">
            <strong>@User.Identity?.Name</strong>
            <span>Your personal account</span>
        </div>
    </div>

    <ul class="profile-nav-list">

        <li class="@(tab == "public" ? "active" : "")">
            <a asp-controller="UserProfile"
               asp-action="Index"
               asp-route-tab="public">
                Public profile
            </a>
        </li>

        <li class="@(tab == "bookings" ? "active" : "")">
            <a asp-controller="UserProfile"
               asp-action="Index"
               asp-route-tab="bookings">
                My bookings
            </a>
        </li>

        <li class="@(tab == "security" ? "active" : "")">
            <a asp-controller="UserProfile"
               asp-action="Index"
               asp-route-tab="security">
                Security
            </a>
        </li>

    </ul>
</nav>
