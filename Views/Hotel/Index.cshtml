@using HotelBooking.ViewModels
@model IEnumerable<HotelViewModelIndex>

<section class="hero-section text-center py-5">
    <div class="container">
        <h1 class="display-6 fw-bold mb-2">Готелі в місті @ViewBag.City</h1>
        <p class="text-muted">Знайдено @Model.Count() готелів</p>
    </div>
</section>

<section class="pb-5">
    <div class="container">
        <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-xl-3">
            @foreach (var hotel in Model)
            {
                <div class="col">
                    <a class="card h-100 text-decoration-none text-reset shadow-sm" asp-controller="Hotel" asp-action="Details" asp-route-hotelId="@hotel.Id">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h5 mb-2">@hotel.Name</h3>
                            <strong class="text-primary mb-2">від @hotel.Price ₴</strong>
                            <p class="text-muted mb-3">@hotel.ShortDescription</p>
                            <span class="mt-auto text-primary fw-semibold">Переглянути →</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>
