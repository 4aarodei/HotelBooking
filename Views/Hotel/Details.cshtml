@using HotelBooking.ViewModels
@model HotelDetailsViewModel

<div class="container py-5">
    <section class="mb-4">
        <p class="eyebrow mb-2">Готель</p>
        <h1 class="display-6 fw-bold mb-2">@Model.Name</h1>
        <p class="text-muted mb-0">@Model.City · @Model.Address</p>
    </section>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0">Про готель</h2>
                        <span class="tag-pill"><i class="bi bi-geo-alt"></i> @Model.City</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="mb-4">@Model.Description</p>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            Опис для цього готелю поки що відсутній.
                        </div>
                    }

                    <div class="mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="h5 mb-0">Доступні кімнати</h2>
                            <span class="text-muted">@Model.Rooms.Count пропозицій</span>
                        </div>
                        @if (!Model.Rooms.Any())
                        {
                            <div class="alert alert-info" role="alert">
                                Наразі немає доступних кімнат
                            </div>
                        }
                        else
                        {
                            <div class="row row-cols-1 row-cols-md-2 g-3">
                                @foreach (var room in Model.Rooms)
                                {
                                    <div class="col">
                                        <div class="card h-100 shadow-sm">
                                            <div class="card-body d-flex flex-column gap-2">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <h3 class="h6 mb-1">@room.Name</h3>
                                                    <span class="badge text-bg-primary">@room.PricePerNight.ToString("0.00") ₴ / ніч</span>
                                                </div>
                                                <div class="room-meta"><i class="bi bi-people"></i> @room.Capacity осіб</div>
                                                <form asp-controller="Booking" asp-action="Create" method="get" class="mt-auto">
                                                    <input type="hidden" name="roomId" value="@room.Id" />
                                                    <button type="submit" class="btn btn-primary w-100">Забронювати</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <aside class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body d-grid gap-3">
                    <div>
                        <span class="text-muted small d-block">Місто</span>
                        <strong>@Model.City</strong>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Адреса</span>
                        <strong>@Model.Address</strong>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Доступних кімнат</span>
                        <strong>@Model.Rooms.Count</strong>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>
