@using HotelBooking.ViewModels
@model List<UserRolesVm>

<div class="container py-5">
    <div class="section-heading">
        <div>
            <p class="eyebrow mb-1">Управління</p>
            <h1 class="h4 mb-0">Користувачі</h1>
            <p class="text-muted mb-0">Керування ролями користувачів системи</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="list-group list-group-flush">
            @foreach (var user in Model)
            {
                <div class="list-group-item">
                    <div class="row align-items-center g-3">
                        <div class="col-md-5">
                            <div class="fw-semibold">@user.Email</div>
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge text-bg-primary">@role</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-7">
                            <form asp-action="UpdateRole" method="post" class="row g-2 align-items-center">
                                <input type="hidden" name="userId" value="@user.UserId" />
                                <div class="col-sm-8">
                                    <select name="role" class="form-select">
                                        @foreach (var role in user.AllRoles)
                                        {
                                            <option value="@role" selected="@(user.Roles.Contains(role))">@role</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-sm-4 d-grid">
                                    <button class="btn btn-primary" type="submit">Зберегти</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
