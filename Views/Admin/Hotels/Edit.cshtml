@model HotelBooking.ViewModels.Admin.AdminHotelFormViewModel
@{
    ViewData["Title"] = "Редагувати готель";
}

<section class="py-5 mt-4">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <p class="text-uppercase text-muted small mb-1">Редагування</p>
                <h1 class="h3 fw-bold mb-0">@Model.Name</h1>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Назад до списку
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <partial name="_HotelForm" />

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-link text-decoration-none">Скасувати</a>
                        <button type="submit" class="btn btn-primary">Оновити</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
