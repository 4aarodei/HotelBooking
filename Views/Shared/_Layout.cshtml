<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HotelBooking</title>

    <!-- GLOBAL STYLES -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- PAGE STYLES -->
    @RenderSection("Styles", required: false)
</head>

@{
            var isHome =
                            ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
                            ViewContext.RouteData.Values["action"]?.ToString() == "Index";
}

<body class="@(isHome ? "no-scroll" : "") @ViewData["BodyClass"]">

    <!-- =========================
         HEADER
         ========================= -->
    <header class="app-header">
        <div class="header-inner">

            <div class="header-left">
                <a class="logo" asp-controller="Home" asp-action="Index">
                    HotelBooking
                </a>
            </div>

            <nav class="header-center">
                <a asp-controller="Home" asp-action="Index">Головна</a>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </nav>

            <div class="header-right">
                <a class="btn-login" asp-area="Identity" asp-page="/Account/Login">
                    Увійти
                </a>
            </div>


        </div>
    </header>

    <!-- =========================
         MAIN
         ========================= -->
    <main id="app">
        @RenderBody()
    </main>

    <!-- =========================
         FOOTER
         ========================= -->
    <footer class="footer">
        <div class="footer-inner">
            © 2025 — HotelBooking ·
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- GLOBAL SCRIPTS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- PAGE SCRIPTS -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
