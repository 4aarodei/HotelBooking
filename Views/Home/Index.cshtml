@using HotelBooking.ViewModels
@model HomeViewModel
@{
    ViewData["Title"] = "Головна";
}

<section class="hero-section text-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <h1 class="display-5 fw-bold mb-3">Бронюйте готелі просто</h1>
                <p class="hero-subtitle mb-4">Знайдіть ідеальне місце для подорожі за кілька кліків</p>

                <form class="search-panel p-4 shadow-sm" method="get" asp-controller="Hotel" asp-action="Index">
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-3 col-sm-6">
                            <label class="form-label text-muted">Місто</label>
                            <input type="text" name="city" class="form-control" placeholder="Вкажіть місто" />
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <label class="form-label text-muted">Дата заїзду</label>
                            <input type="date" name="checkIn" class="form-control" />
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <label class="form-label text-muted">Дата виїзду</label>
                            <input type="date" name="checkOut" class="form-control" />
                        </div>
                        <div class="col-lg-2 col-sm-6">
                            <label class="form-label text-muted">Гості</label>
                            <select name="guests" class="form-select">
                                @for (int i = 1; i <= 6; i++)
                                {
                                    <option value="@i">@i гість</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-1 d-grid">
                            <button type="submit" class="btn btn-primary" formnovalidate>Знайти</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title h4 mb-0">Популярні готелі</h2>
            <span class="text-muted">@Model?.PopularHotels?.Count() ?? 0 пропозицій</span>
        </div>

        @if (Model?.PopularHotels != null && Model.PopularHotels.Any())
        {
            <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-xl-3">
                @foreach (var hotel in Model.PopularHotels)
                {
                    <div class="col">
                        <a asp-controller="Hotel" asp-action="Details" asp-route-hotelId="@hotel.Id" class="card h-100 text-decoration-none text-reset shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h3 class="h5 mb-2">@hotel.Name</h3>
                                <p class="text-muted mb-3">@hotel.City · від @hotel.MinPrice.ToString("0") ₴</p>
                                <span class="mt-auto text-primary fw-semibold">Дивитися деталі →</span>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-secondary" role="alert">
                Наразі немає популярних готелів
            </div>
        }
    </div>
</section>
