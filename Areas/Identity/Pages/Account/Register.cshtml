@page
@model RegisterModel

@{
    ViewData["Title"] = "Реєстрація";
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-shell">
    <div class="auth-card">
        <p class="eyebrow mb-2 text-uppercase">Приєднуйтесь</p>
        <h1 class="auth-title">Реєстрація</h1>
        <p class="auth-subtitle">Створіть новий акаунт</p>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="auth-error"></div>

            <div class="form-group">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" autocomplete="username" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" autocomplete="new-password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-2">
                Зареєструватися
            </button>
        </form>

        <div class="auth-links">
            <a asp-page="./Login">Вже маєте акаунт? Увійти</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
