@page
@model RegisterModel

@{
    ViewData["Title"] = "Реєстрація";
    ViewData["BodyClass"] = "auth-page";
}



@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h1 class="auth-title">Реєстрація</h1>
        <p class="auth-subtitle">Створіть новий акаунт</p>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="auth-error"></div>

            <div class="form-group">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" autocomplete="username" />
                <span asp-validation-for="Input.Email"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword"></span>
            </div>

            <button type="submit" class="btn-primary">
                Зареєструватися
            </button>
        </form>

        <div class="auth-links">
            <a asp-page="./Login">Вже маєте акаунт? Увійти</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
