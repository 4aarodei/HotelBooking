@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Адмін панель";
}

<section class="py-5 mt-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <p class="text-uppercase text-muted small mb-1">Адміністрування</p>
                <h1 class="h3 fw-bold mb-0">Інструменти керування</h1>
            </div>
            <span class="badge text-bg-primary px-3 py-2">@User.Identity?.Name</span>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center mb-3">
                            <span class="badge bg-primary bg-opacity-10 text-primary p-3 rounded-circle me-3">
                                <i class="bi bi-building"></i>
                            </span>
                            <div>
                                <p class="text-muted small mb-0">Готелі</p>
                                <h5 class="mb-0">Менеджмент готелів</h5>
                            </div>
                        </div>
                        <p class="text-muted flex-grow-1">Додавайте нові готелі, оновлюйте описи, адреси та інші дані.</p>
                        <a asp-controller="Hotels" asp-action="Index" class="btn btn-outline-primary align-self-start">Відкрити</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center mb-3">
                            <span class="badge bg-success bg-opacity-10 text-success p-3 rounded-circle me-3">
                                <i class="bi bi-graph-up"></i>
                            </span>
                            <div>
                                <p class="text-muted small mb-0">Статистика</p>
                                <h5 class="mb-0">Бронювання</h5>
                            </div>
                        </div>
                        <p class="text-muted flex-grow-1">Огляд ключових показників бронювань з можливістю вибору діапазону дат.</p>
                        <a asp-controller="Statistics" asp-action="Index" class="btn btn-outline-success align-self-start">Перейти</a>
                    </div>
                </div>
            </div>

            @if (Model.CanManageRoles)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center mb-3">
                                <span class="badge bg-warning bg-opacity-10 text-warning p-3 rounded-circle me-3">
                                    <i class="bi bi-people"></i>
                                </span>
                                <div>
                                    <p class="text-muted small mb-0">Користувачі</p>
                                    <h5 class="mb-0">Ролі та доступи</h5>
                                </div>
                            </div>
                            <p class="text-muted flex-grow-1">Керування ролями користувачів для доступу до адмін-можливостей.</p>
                            <a asp-controller="Users" asp-action="Index" class="btn btn-outline-warning align-self-start">Відкрити</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
